rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Only the configured owner UID can change dashboard data.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'mohamedmosad1412@icloud.com'
      );
    }
    function isStaff() { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'cashier'); }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    match /expenses/{expenseId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staff/{staffId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
